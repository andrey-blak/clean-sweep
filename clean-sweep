#!/usr/bin/env bash

# Removes scratch dirs (e.g. .claude, .hermes, .cc-writes, ...)
# Config: ~/.config/clean-sweep/config.ini (override: -c FILE or CLEAN_SWEEP_CONFIG)
# Usage:  clean-sweep [-n|--dry-run] [-c|--config FILE]

set -euo pipefail

NAME="clean-sweep"
CONFIG="${CLEAN_SWEEP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/$NAME/config.ini}"
CLI_DRY=0
while (( $# )); do
  case "$1" in
    -n|--dry-run) CLI_DRY=1 ;;
    -c|--config)  CONFIG="${2:?--config needs a path}"; shift ;;
    -h|--help)    echo "Usage: $NAME [-n|--dry-run] [-c|--config FILE]"; exit 0 ;;
    *) echo "$NAME: unknown option: $1" >&2; exit 2 ;;
  esac
  shift
done
[[ -f "$CONFIG" ]] || { echo "$NAME: no config at $CONFIG" >&2; exit 1; }

# ---------- helpers ----------
trim() { local s=$1; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }
unquote() {
  local s=$1
  if (( ${#s} >= 2 )) && [[ ${s:0:1} == '"' && ${s: -1} == '"' ]]; then s="${s:1:${#s}-2}"; fi
  printf '%s' "$s"
}
# Expand ${VAR:-default}, ${VAR}, $VAR and leading ~ / ~user.
# Single pass, left to right: substituted values are inserted verbatim and never re-scanned, so self-referential variables (A='${A}') cannot loop.
# The :- default is expanded one bounded level (supports ${X:-$HOME/d}).
# No eval. Unknown ~user is a fatal config error.
expand_once() {
  local rest=$1 out="" tok pre var val
  while [[ $rest =~ \$\{([A-Za-z_][A-Za-z0-9_]*)(:-([^}]*))?\}|\$([A-Za-z_][A-Za-z0-9_]*) ]]; do
    tok=${BASH_REMATCH[0]}
    pre=${rest%%"$tok"*}
    if [[ -n ${BASH_REMATCH[1]} ]]; then
      var=${BASH_REMATCH[1]}
      val=${!var-}
      if [[ -z $val ]]; then val=$(expand_once "${BASH_REMATCH[3]-}"); fi
    else
      var=${BASH_REMATCH[4]}
      val=${!var-}
    fi
    out+=$pre$val
    rest=${rest#*"$tok"}
  done
  printf '%s' "$out$rest"
}
expand() {
  local s=$1 home user
  if [[ $s == '~'* ]]; then
    user=${s%%/*}; user=${user#\~}
    if [[ -z $user ]]; then
      home=$HOME
    else
      home=$(getent passwd "$user" | cut -d: -f6) || home=""
      if [[ -z $home ]]; then
        echo "$NAME: unknown user '~$user' in: $s" >&2; return 1
      fi
    fi
    s=$home${s#\~"$user"}
  fi
  expand_once "$s"
}
# Quote-aware comma split -> global SPLIT[]
split_csv() {
  local s=$1 cur="" inq=0 i c e
  local parts=()
  for ((i=0; i<${#s}; i++)); do
    c=${s:i:1}
    if [[ $c == '"' ]]; then inq=$((1-inq)); cur+=$c
    elif [[ $c == ',' && $inq -eq 0 ]]; then parts+=("$cur"); cur=""
    else cur+=$c; fi
  done
  parts+=("$cur")
  SPLIT=()
  for e in "${parts[@]}"; do
    e=$(unquote "$(trim "$e")")
    if [[ -n "$e" ]]; then SPLIT+=("$e"); fi
  done
  return 0
}

# ---------- parse INI (full-line # / ; comments only) ----------
ROOTS_RAW=""; EXCLUDE_RAW=""; MIN_AGE_HOURS=24; DRY_RUN=false
declare -A T_MODE T_AGE
section=""
while IFS= read -r line || [[ -n "$line" ]]; do
  line=$(trim "$line")
  if [[ -z "$line" || $line == '#'* || $line == ';'* ]]; then continue; fi
  if [[ $line == '['*']' ]]; then section=${line:1:${#line}-2}; continue; fi
  if [[ $line != *=* ]]; then continue; fi
  key=$(unquote "$(trim "${line%%=*}")")
  val=$(trim "${line#*=}")
  case $section in
    scan)
      case $key in
        roots)         ROOTS_RAW=$val ;;
        exclude)          EXCLUDE_RAW=$val ;;
        min_age_hours) MIN_AGE_HOURS=$val ;;
        dry_run)       DRY_RUN=$val ;;
      esac ;;
    targets)
      val=$(unquote "$val")
      mode=$(trim "${val%%,*}")
      if [[ $val == *,* ]]; then age=$(trim "${val#*,}"); else age=""; fi
      if [[ $mode != empty && $mode != force ]]; then
        echo "$NAME: bad mode for '$key': $mode" >&2; exit 1
      fi
      T_MODE["$key"]=$mode
      if [[ -n "$age" ]]; then T_AGE["$key"]=$age; fi ;;
  esac
done < "$CONFIG"

if (( CLI_DRY )); then DRY_RUN=true; fi
if [[ -z "$ROOTS_RAW" || ${#T_MODE[@]} -eq 0 ]]; then
  echo "$NAME: config needs [scan] roots and [targets]" >&2; exit 1
fi
if [[ ! $MIN_AGE_HOURS =~ ^[0-9]+$ ]]; then
  echo "$NAME: min_age_hours must be a whole number" >&2; exit 1
fi
# cap at 100 years; length check first so huge literals can't overflow (( ))
if (( ${#MIN_AGE_HOURS} > 6 || MIN_AGE_HOURS > 876000 )); then
  echo "$NAME: min_age_hours too large (max 876000)" >&2; exit 1
fi
if [[ $DRY_RUN != true && $DRY_RUN != false ]]; then
  echo "$NAME: dry_run must be true or false" >&2; exit 1
fi
for k in "${!T_AGE[@]}"; do
  if [[ ! ${T_AGE[$k]} =~ ^[0-9]+$ ]]; then
    echo "$NAME: bad age_hours for '$k': ${T_AGE[$k]}" >&2; exit 1
  fi
  if (( ${#T_AGE[$k]} > 6 || T_AGE[$k] > 876000 )); then
    echo "$NAME: age_hours too large for '$k' (max 876000)" >&2; exit 1
  fi
done

# ---------- expand tokens, canonicalize, build lookup tables ----------
SCAN_ERRORS=0
split_csv "$ROOTS_RAW"; ROOTS=("${SPLIT[@]}")
split_csv "$EXCLUDE_RAW";  EXCLUDE=("${SPLIT[@]}")
# Canonicalize roots (resolves symlinks and ..): find output is then canonical too, and symlinked roots work instead of being silently skipped.
declare -A SEEN_ROOT
CANON_ROOTS=()
for r in "${ROOTS[@]}"; do
  r=$(expand "$r")
  if ! cr=$(realpath -e -- "$r" 2>/dev/null); then
    echo "$NAME: root not accessible: $r" >&2; SCAN_ERRORS=$((SCAN_ERRORS+1)); continue
  fi
  if [[ $cr == / ]]; then echo "$NAME: refusing root: /" >&2; continue; fi
  if [[ -z ${SEEN_ROOT[$cr]+x} ]]; then SEEN_ROOT["$cr"]=1; CANON_ROOTS+=("$cr"); fi
done
ROOTS=("${CANON_ROOTS[@]}")
if (( ${#ROOTS[@]} == 0 )); then echo "$NAME: no usable roots" >&2; exit 1; fi

declare -A MODE AGE
for k in "${!T_MODE[@]}"; do
  xk=$(expand "$k")
  if [[ $xk == /* ]]; then xk=$(realpath -m -- "$xk"); fi
  MODE["$xk"]=${T_MODE[$k]}
  if [[ -n ${T_AGE[$k]+x} ]]; then AGE["$xk"]=${T_AGE[$k]}; fi
done

# ---------- find expressions ----------
declare -A BASENAMES
for k in "${!MODE[@]}"; do BASENAMES["${k##*/}"]=1; done
name_expr=(\( -false)
for b in "${!BASENAMES[@]}"; do name_expr+=(-o -name "$b"); done
name_expr+=(\))
exclude_expr=()
if (( ${#EXCLUDE[@]} )); then
  exclude_expr=(\( -false)
  for s in "${EXCLUDE[@]}"; do exclude_expr+=(-o -name "$s"); done
  exclude_expr+=(\) -prune -o)
fi

# Most specific matching target wins: absolute > longer relative path > bare name.
match_key() {
  local p=$1 b=${1##*/} k best="" spec=-1 s
  for k in "${!MODE[@]}"; do
    if [[ $k == /* ]]; then
      if [[ $p == "$k" ]]; then s=100000; else continue; fi
    elif [[ $k == */* ]]; then
      if [[ $p == */"$k" ]]; then s=${#k}; else continue; fi
    else
      if [[ $b == "$k" ]]; then s=0; else continue; fi
    fi
    if (( s > spec )); then spec=$s; best=$k; fi
  done
  printf '%s' "$best"
}

# ---------- phase 1: collect candidates + snapshot mtime and identity ----------
# Age is judged against scan-time mtimes; dev:ino snapshots let phase 2 detect path replacement and protect / and $HOME by identity, not spelling. find runs into temp files so its exit status and stderr are not lost: a partial/inaccessible scan is reported and fails the run, not hidden.
SWEEP_TMP=$(mktemp -d)
trap 'rm -rf "$SWEEP_TMP"' EXIT
NOW=$(date +%s)
HOME_ID=$(stat -c '%d:%i' -- "$HOME" 2>/dev/null) || HOME_ID=""
ROOT_ID=$(stat -c '%d:%i' / 2>/dev/null) || ROOT_ID=""
PATHS=(); MTIMES=(); IDS=()
for root in "${ROOTS[@]}"; do
  if [[ ! -d $root ]]; then
    echo "$NAME: exclude root: $root" >&2; SCAN_ERRORS=$((SCAN_ERRORS+1)); continue
  fi
  if ! find "$root" -mindepth 1 -xdev \
      "${exclude_expr[@]}" "${name_expr[@]}" -type d -print0 \
      > "$SWEEP_TMP/find.out" 2> "$SWEEP_TMP/find.err"; then
    echo "$NAME: scan incomplete for root: $root" >&2
    sed "s/^/$NAME:   /" "$SWEEP_TMP/find.err" >&2
    SCAN_ERRORS=$((SCAN_ERRORS+1))
  fi
  mapfile -d '' -t found < "$SWEEP_TMP/find.out"
  for p in "${found[@]}"; do
    if ! meta=$(stat -c '%Y %d %i' -- "$p" 2>/dev/null); then
      echo "$NAME: stat failed (vanished?): $p" >&2
      SCAN_ERRORS=$((SCAN_ERRORS+1)); continue
    fi
    read -r m dev ino <<< "$meta"
    PATHS+=("$p"); MTIMES+=("$m"); IDS+=("$dev:$ino")
  done
done

# ---------- phase 2: delete, children before parents (reverse preorder) ----------
# In dry-run, SIM tracks "virtually deleted" paths so cascading parents are previewed exactly as a real run would remove them — without touching disk.
removed=0
declare -A SIM=()
for ((i=${#PATHS[@]}-1; i>=0; i--)); do
  p=${PATHS[i]}; m=${MTIMES[i]}; id=${IDS[i]}
  if [[ ! -d $p || $p == / || $p == "$HOME" ]]; then continue; fi
  if [[ -n $HOME_ID && $id == "$HOME_ID" ]]; then continue; fi
  if [[ -n $ROOT_ID && $id == "$ROOT_ID" ]]; then continue; fi
  k=$(match_key "$p")
  if [[ -z "$k" ]]; then continue; fi
  hours=${AGE[$k]:-$MIN_AGE_HOURS}
  if (( NOW - m < hours * 3600 )); then continue; fi
  # Re-verify identity right before deleting (TOCTOU mitigation): if the path was replaced since the scan, leave the newcomer alone. rmdir is already atomic for empty mode; this also protects force mode.
  if ! cur=$(stat -c '%d:%i' -- "$p" 2>/dev/null); then continue; fi
  if [[ $cur != "$id" ]]; then
    echo "$NAME: skipped (replaced since scan): $p" >&2
    continue
  fi
  if [[ ${MODE[$k]} == empty ]]; then
    if [[ $DRY_RUN == true ]]; then
      # virtually empty iff every actual entry is virtually deleted
      mapfile -d '' -t entries < <(find "$p" -mindepth 1 -maxdepth 1 -printf '%f\0' 2>/dev/null)
      virt_empty=1
      for e in "${entries[@]}"; do
        if [[ -z ${SIM[$p/$e]+x} ]]; then virt_empty=0; break; fi
      done
      if (( virt_empty )); then
        SIM["$p"]=1
        echo "would remove (empty): $p"; removed=$((removed+1))
      fi
    elif rmdir -- "$p" 2>/dev/null; then
      echo "removed (empty): $p"; removed=$((removed+1))
    fi
  else
    if [[ $DRY_RUN == true ]]; then
      SIM["$p"]=1
      echo "would FORCE-remove: $p"
    else
      rm -rf -- "$p"; echo "FORCE-removed: $p"
    fi
    removed=$((removed+1))
  fi
done
if [[ $DRY_RUN == true ]]; then
  echo "$NAME: $removed dir(s) would be removed (dry run)"
else
  echo "$NAME: $removed dir(s) removed"
fi
if (( SCAN_ERRORS )); then
  echo "$NAME: completed with $SCAN_ERRORS scan error(s)" >&2
  exit 1
fi
